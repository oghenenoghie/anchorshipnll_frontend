# Neon Postgres — pooled connection string (app runtime)
DATABASE_URL=

# Neon Postgres — direct/unpooled connection string (migrations only)
DIRECT_URL=

# Neon API key, only needed if provisioning DB branches in CI
NEON_API_KEY=

# Admin sign-in (/admin) — single-admin credential, no external identity
# provider. Generate ADMIN_PASSWORD_HASH with: npm run admin:hash-password -- "your-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Random 32+ byte secret signing the admin session cookie, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Neon Object Storage — listing photos. Create a credential with the
# storage:read and storage:write scopes on the main branch (Neon Console →
# Branch → Credentials); it also works on preview branches forked from main.
# Branch storage endpoint, e.g. https://br-….storage.c-5.eu-central-1.….neon.tech
NEON_STORAGE_ENDPOINT=
# Region shown with the endpoint, e.g. eu-central-1
NEON_STORAGE_REGION=
# The credential's key ID (token_id, starts nak_) and storage secret (starts nsk_)
NEON_STORAGE_KEY_ID=
NEON_STORAGE_SECRET=
# public_read bucket holding the photos
NEON_STORAGE_BUCKET=stock-photos

# Transactional email (RFQ / contact notifications). Without RESEND_API_KEY,
# submissions are logged to the server console instead of sent — safe for local dev.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="AnchorShip NL <notifications@anchorship.nl>"
NOTIFY_TO_EMAIL=sales@anchorship.nl

# Local dev server port (Railway sets this in production)
PORT=3000
